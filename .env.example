# RANKING_HTS_TOP_VIEW_INITIAL_DELAY_MS=1000
# RANKING_HTS_TOP_VIEW_POLL_INTERVAL_MS=10000
# RANKING_HTS_TOP_VIEW_CACHE_TTL_SECONDS=30
# JPA_DDL_AUTO=none
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false

# AWS ElastiCache Redis
# SPRING_DATA_REDIS_HOST=your-primary-or-configuration-endpoint.cache.amazonaws.com
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_SSL_ENABLED=true
# SPRING_DATA_REDIS_TIMEOUT=3s

# Korea Investment Securities Open API
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# KIS_ENVIRONMENT=demo
# KIS_APP_KEY=your-kis-app-key
# KIS_APP_SECRET=your-kis-app-secret
# KIS_ACCOUNT_NUMBER=your-8-digit-account-number
# KIS_ACCOUNT_PRODUCT_CODE=01
# KIS_CUSTOMER_TYPE=P
# KIS_EXCHANGE_ID=KRX

# Kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# ORDER_REQUESTED_TOPIC=order-requested
# ORDER_CANCEL_REQUESTED_TOPIC=order-cancel-requested
# KAFKA_SEND_TIMEOUT=3s
# ORDER_CANCEL_PENDING_TTL=30s
# TRADE_SYNC_KAFKA_ENABLED=false
# TRADE_SYNC_EXECUTION_CONFIRMED_TOPIC=execution.confirmed
# TRADE_SYNC_CONSUMER_GROUP=trade-sync-worker
# TRADE_SYNC_AUTO_OFFSET_RESET=earliest

# Observability
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
# MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
# MANAGEMENT_TRACING_ENABLED=true
# OTEL_TRACES_SAMPLER_PROBABILITY=1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
