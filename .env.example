# Copy this file to .env and fill in real values.
# Never commit .env.

SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3307/fisaschool?sslMode=trust&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your-rds-username
SPRING_DATASOURCE_PASSWORD=your-rds-password

# Secrets are stored in each service's application-secret.properties.
# Auth service: apps/api/auth-service/src/main/resources/application-secret.properties

# Optional
# SPRING_PROFILES_ACTIVE=local
# AUTH_SERVICE_PORT=8081
# ORDER_SERVICE_PORT=8084
# NOTIFICATION_API_PORT=8086
# MARKET_SERVICE_PORT=8085
# REALTIME_QUOTE_INGESTOR_PORT=8087
# QUOTE_SOURCE_MODE=mock
# QUOTE_INGESTION_AUTO_START=true
# QUOTE_INGESTION_STOCK_CODES=
# QUOTE_MOCK_EMIT_INTERVAL_MILLIS=1000
# STOCK_MASTER_LOAD_ENABLED=false
# STOCK_MASTER_KOSPI_PATH=
# STOCK_MASTER_KOSDAQ_PATH=
# STOCK_MASTER_FAIL_FAST=false
# REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS_ENABLED=false
# REDIS_SSL_VERIFY_PEER=true
# REDIS_QUOTE_TTL_SECONDS=300
# REDIS_MARKET_STATUS_TTL_SECONDS=60
# REDIS_CONNECT_TIMEOUT=3s
# REDIS_COMMAND_TIMEOUT=3s
# KIS_APPROVAL_URL=http://210.107.75.78:9443/oauth2/Approval
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# KIS_TOKEN_URL=https://openapivts.koreainvestment.com:29443/oauth2/tokenP
# KIS_ENVIRONMENT=demo
# KIS_WEBSOCKET_URL=ws://210.107.75.79:21000
# KIS_PRICE_TR_ID=H0STCNT0
# KIS_ORDERBOOK_TR_ID=H0STASP0
# KIS_INDEX_TR_ID=H0UPCNT0
# KIS_HTS_TOP_VIEW_TR_ID=HHMCM000100C0
