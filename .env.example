# Copy this file to .env and fill in real values.
# Never commit .env.

SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3307/fisaschool?sslMode=trust&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your-rds-username
SPRING_DATASOURCE_PASSWORD=your-rds-password

# Secrets are stored in each service's application-secret.properties.
# Auth service: apps/api/auth-service/src/main/resources/application-secret.properties

# Optional
# SPRING_PROFILES_ACTIVE=local
# AUTH_SERVICE_PORT=8081
# ORDER_SERVICE_PORT=8084
# NOTIFICATION_API_PORT=8086
# MARKET_SERVICE_PORT=8085
# JPA_DDL_AUTO=none
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false

# AWS ElastiCache Redis
# SPRING_DATA_REDIS_HOST=your-primary-or-configuration-endpoint.cache.amazonaws.com
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_SSL_ENABLED=true
# SPRING_DATA_REDIS_TIMEOUT=3s

# Korea Investment Securities Open API
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# KIS_ENVIRONMENT=demo
# KIS_APP_KEY=your-kis-app-key
# KIS_APP_SECRET=your-kis-app-secret
# KIS_ACCOUNT_NUMBER=your-8-digit-account-number
# KIS_ACCOUNT_PRODUCT_CODE=01
# KIS_CUSTOMER_TYPE=P
# KIS_EXCHANGE_ID=KRX

# Kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# ORDER_REQUESTED_TOPIC=order-requested
# ORDER_CANCEL_REQUESTED_TOPIC=order-cancel-requested
# KAFKA_SEND_TIMEOUT=3s
# ORDER_CANCEL_PENDING_TTL=30s
